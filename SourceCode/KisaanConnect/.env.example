# ===================================================
# KisaanConnect Environment Variables Configuration
# ===================================================
# NOTE: Do NOT commit real secret values to version control.
# In Railway, these variables are configured in Dashboard -> Variables.

# Railway dynamic port (automatically set by Railway runtime)
PORT=8080

# ---------------------------------------------------
# Database Configuration (Railway MySQL Service)
# ---------------------------------------------------
# Railway provides either MYSQL_URL or individual variables:
MYSQL_URL=
MYSQLHOST=
MYSQLPORT=3306
MYSQLDATABASE=kisaanconnect
MYSQLUSER=
MYSQLPASSWORD=

# ---------------------------------------------------
# Payment Gateway (Razorpay Sandbox / Production)
# ---------------------------------------------------
# Optional: if omitted, application uses safe simulated development sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------
# AI Assistant (Google Gemini AI API Key)
# ---------------------------------------------------
# Optional: if omitted, rule-based agricultural fallback is active
GEMINI_API_KEY=
